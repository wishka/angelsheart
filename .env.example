# Скопируйте в .env и заполните. Сам .env в репозиторий не коммитится.

# ===== Режим =====
# DEBUG=False по умолчанию. Включайте True только локально.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://example.ru

# ===== Секреты =====
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ВНИМАНИЕ: при смене ключа ранее зашифрованные паспорта и реквизиты
# станут нечитаемы. Смена ключа требует перешифровки данных.
ENCRYPTION_KEY=

# ===== База данных =====
# При DEBUG=False обязателен PostgreSQL: на SQLite не работает
# блокировка строк, на которой держится корректность денежных операций.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ===== Кеш =====
# Обязателен при DEBUG=False: в нём живут счётчики попыток входа
REDIS_URL=redis://localhost:6379/0

# ===== За обратным прокси =====
BEHIND_PROXY=False
TRUSTED_PROXY_COUNT=1

# ===== Платежи =====
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
PAYMENT_MODE=test
USE_REAL_PAYMENTS=False
PAYMENT_SUCCESS_URL=http://localhost:8000/payment/success/
PAYMENT_CANCEL_URL=http://localhost:8000/payment/cancel/
# Актуальный список: https://yookassa.ru/developers/using-api/webhooks
# YOOKASSA_WEBHOOK_IPS=185.71.76.0/27,185.71.77.0/27,...

# Комиссия сервиса с пожертвования, %. Должна совпадать с офертой.
DONATION_COMMISSION_PERCENT=0

# ===== Почта =====
# При DEBUG=False консольный бэкенд запрещён: письма уходили бы в stdout,
# а сервис считал бы пользователя уведомлённым
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.ru
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.ru

SITE_URL=http://localhost:8000

# ===== Реквизиты оператора =====
# Пока не заполнены, на всех юридических документах висит предупреждение:
# политика без сведений об операторе не соответствует ч. 4 ст. 9 152-ФЗ,
# а оферта без сведений о том, кто делает предложение, договор не порождает.
OPERATOR_FORM=Индивидуальный предприниматель
OPERATOR_NAME=
OPERATOR_SHORT_NAME=
OPERATOR_OGRNIP=
OPERATOR_INN=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
OPERATOR_SUPPORT_EMAIL=
OPERATOR_PHONE=
# Номер уведомления в реестре операторов (ст. 22 152-ФЗ)
OPERATOR_RKN_NOTICE=
# Ответственный за организацию обработки ПДн (ч. 1 ст. 22.1 152-ФЗ).
# На этот адрес уходят оповещения о сроках 24/72 ч по инцидентам.
OPERATOR_DPO_NAME=
OPERATOR_DPO_EMAIL=

# ===== Модерация сборов =====
FUNDRAISE_BASIC_VERIFICATION_THRESHOLD=50000
FUNDRAISE_FULL_VERIFICATION_THRESHOLD=300000
FUNDRAISE_LARGE_AMOUNT=500000
FUNDRAISE_MIN_DESCRIPTION_LENGTH=200
FUNDRAISE_MAX_DOCUMENTS=10

# ===== Выплаты через СБП =====
# Идентификаторы банков из личного кабинета ЮKassa (продукт «Выплаты»).
# Пока пусто, способ «СБП» пользователю не предлагается.
# SBP_BANKS=100000000111:Сбербанк,100000000004:Тинькофф
SBP_BANKS=

# ===== Почта: подтверждение адреса =====
# Как часто можно просить письмо подтверждения повторно, секунд
EMAIL_CONFIRMATION_RESEND_SECONDS=300
# Дополнительные домены одноразовой почты, через запятую
DISPOSABLE_EMAIL_DOMAINS=
