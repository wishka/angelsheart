<?xml version="1.0" encoding="utf-8"?>
<!--
    Боевая (release) сборка: только HTTPS.

    Отладочная сборка подменяет этот файл своим из src/debug/res/xml —
    там незашифрованный HTTP разрешён, чтобы работали 127.0.0.1 через
    adb reverse, эмулятор и сервер на ноутбуке по Wi-Fi. В выпуск это
    разрешение не попадает: токены и переписка по открытому HTTP читаются
    любым, кто сидит в той же сети.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
