<?xml version="1.0" encoding="utf-8"?>
<!--
    Обычный HTTP разрешён везде — только в ОТЛАДОЧНОЙ сборке (src/debug).
    Release-сборка берёт строгий файл из src/main: там только HTTPS.

    Начиная с Android 9 незашифрованный HTTP запрещён по умолчанию, и без
    этого файла приложение не достучалось бы до сервера на ноутбуке вовсе.
    Ошибка при этом выглядит как «сервер недоступен», а не как запрет,
    и её ищут часами.

    Первая версия перечисляла адреса поимённо и содержала
    <domain>192.168.0.0</domain> в надежде разрешить всю локальную сеть.
    Так это не работает: <domain> сравнивается с именем узла точно,
    диапазонов адресов конфигурация сетевой безопасности не поддерживает
    вовсе. То есть подключение по Wi-Fi к 192.168.1.42 отклонялось —
    ровно тот способ, который советует экран настроек.

-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
